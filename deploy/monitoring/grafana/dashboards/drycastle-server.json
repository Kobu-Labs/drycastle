  {
   "type": "stat",
   "title": "Last report",
   "description": "Seconds since the server last sent its numbers. It sends every 10 s: more than two minutes means it is down or hung.",
   "datasource": {
    "type": "prometheus",
    "uid": "metrics"
   },
   "id": 2,
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 30
       },
       {
        "color": "red",
        "value": 120
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "metrics"
     },
     "expr": "time() - timestamp(drycastle_up_reports)",
     "refId": "A"
