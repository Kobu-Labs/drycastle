# Copy to .env (never commit it) and set a long random password: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
# Optional: player_token(s) of the admins (comma-separated); the server passes them as --admin-token. Empty: nobody is admin.
ADMIN_TOKEN=
# Optional: host ports. GAME_PORT (UDP, default 27015); PACK_PORT (TCP, default 27080: the encrypted private asset pack; it is part of the
# URL in private-pack.json, so changing it means publishing the pack again with PACK_PORT set).
#GAME_PORT=27015
#PACK_PORT=27080
