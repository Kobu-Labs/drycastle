<Project Sdk="Godot.NET.Sdk/4.7.2">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Drycastle.MapLoader</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The water surface shader ships inside the assembly so the viewer and the shooter (separate Godot projects) share one file. -->
    <EmbeddedResource Include="Water/water_surface.gdshader" LogicalName="water_surface.gdshader" />
    <!-- The tree cut (pack trees, #287): the baked props material, the pack tree material and the code they share. -->
    <EmbeddedResource Include="Shaders/tree_cut.gdshaderinc" LogicalName="tree_cut.gdshaderinc" />
    <EmbeddedResource Include="Shaders/props_tree_cut.gdshader" LogicalName="props_tree_cut.gdshader" />
    <EmbeddedResource Include="Shaders/pack_tree.gdshader" LogicalName="pack_tree.gdshader" />
    <EmbeddedResource Include="Shaders/crop_plant.gdshader" LogicalName="crop_plant.gdshader" />
    <EmbeddedResource Include="Shaders/crop_sheet.gdshader" LogicalName="crop_sheet.gdshader" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pure collision geometry (trees, placed objects), shared with the server and the tests. -->
    <ProjectReference Include="../ShooterCore/ShooterCore.csproj" />
  </ItemGroup>

</Project>
