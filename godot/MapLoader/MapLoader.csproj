<Project Sdk="Godot.NET.Sdk/4.7.2">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Drycastle.MapLoader</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The water surface shader ships inside the assembly so the viewer and the shooter (separate Godot projects) share one file. -->
    <EmbeddedResource Include="Water/water_surface.gdshader" LogicalName="water_surface.gdshader" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pure collision geometry (trees, placed objects), shared with the server and the tests. -->
    <ProjectReference Include="../ShooterCore/ShooterCore.csproj" />
  </ItemGroup>

</Project>
