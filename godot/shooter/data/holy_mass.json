{
  "version": 1,
  // The Holy Mass event: the citizens and the Mass. Times in seconds, lengths in metres, speeds in metres per second.
  "citizens": {
    // Most citizens alive or waiting to leave their houses at once (the church's seats limit it further).
    "max_count": 120,
    "walk_speed": 2.2,
    // The sprint back home when the demon appears (times the same random factor).
    "flee_speed": 6,
    // Each citizen walks at walk_speed times a random factor within this share either way.
    "speed_jitter": 0.12,
    "turn_rate_deg_per_s": 360,
    // Defaults of a batch (the server's spawn call takes its own): the time over which a batch leaves its houses, the radius
    // around the church door in which houses send citizens, and the nearest house that sends one (not the church's own plot).
    "stagger_seconds": 30,
    "house_radius_m": 150,
    "house_min_m": 20,
    // How long a killed citizen lies before it is removed.
    "corpse_seconds": 15,
    // Height of the pews' seats: church.json gives the seat point on the seat; a sitter is hit as a crouching body standing under it.
    "seat_height_m": 0.51,
    // Civilian clothing and skin, picked per citizen from its look number.
    "palette": ["#4a4038", "#5b4a36", "#3d4654", "#554a5e", "#6b3f3a", "#4b5543", "#2f2f33", "#7a6a55"],
    "skin_tones": ["#f0c8a4", "#e0ac84", "#c68e5f"],
    // The bodies (the swap point: a model of another pack is another entry here). The character pack is one 23-bone rig, 3.147 units tall as imported,
    // that faces +Z; its sit clip ends with the pelvis 0.647 units above the origin and 0.389 units behind it (measured in the clip).
    // Surfaces are the material names of the model.
    "models": [
      { "file": "peasant_male_01" },
      { "file": "peasant_female_01" },
      { "file": "peasant_female_02" }
    ]
  },
  "mass": {
    // The timeline: citizens walk in during the gather, then the Mass runs for mass_seconds of progress (paused while the pastor is gone), then
    // completed_seconds of standing, clapping and the pastor's flex before everyone is removed. A house 100 m away is 70 s of walking, so with the
    // stagger every citizen is seated before the gather ends.
    "gather_seconds": 120,
    // The Mass begins this long after the last citizen still coming has reached its place; gather_seconds stays the upper limit.
    "start_delay_seconds": 4,
    "mass_seconds": 120,
    "completed_seconds": 12,
    "stagger_seconds": 25,
    "house_radius_m": 100,
    // The bells ring at the start; the first citizen leaves its house this many seconds later, and the gather's clock starts then.
    "bells_lead_seconds": 6,
    // Seats no citizen is sent to, for players (ground floor, spread along the nave). Players can also take a seat a killed citizen left once its body is gone.
    "player_seats": 8,
    "sit_reach_m": 1.6,
    // Blessing: seated at the end for at least this share of the Mass, and not a sinner.
    "blessed_share": 0.8,
    // A killed pastor: the Mass pauses; a new one comes out of the sacristy after replace seconds, and the Mass resumes resume seconds after he arrived.
    "pastor_replace_seconds": 10,
    "resume_seconds": 5,
    "pastor_kills_to_turn": 3,
    "clap_share": 0.4,
    "pastor_model": "priest_01",
    "monk_model": "monk_01",
    "atlas": "glb/atlas/fantasy_kingdom_01_A.png",
    // The pastor gestures every few seconds between the praying clips; a shocked monk dabs this share of the time.
    "gesture_min_seconds": 5,
    "gesture_max_seconds": 11,
    "monk_dab_share": 0.03,
    // Paths are under the shipped assets (the chant is looked up in the private pack first). A file that is missing is skipped (logged once).
    // The chant is not made yet. The bells are generated by scripts/make_church_bells.py and play once, village-wide.
    "chant_sound": "audio/holy_mass/chant.ogg",
    "bells_sound": "drycastle-generated-sounds/church_bells.ogg",
    "chant_range_m": 40
  }
}
