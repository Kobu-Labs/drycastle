{
  "version": 1,
  // Every number of the Thieves event (GLOSSARY: Thieves event, Raid, Gang member). Lengths are metres, speeds metres per second, times seconds.
  "gang": {
    // The crew of one Raid. (Ticket 03 scales it with the players.)
    "raid": { "gang_bosses": 1, "enforcers": 2, "thieves": 5 },
    // Hits is the Hit count: the weighted hits a member takes before it dies (a bullet 1, a headshot 2, see hits below). A player walks at 5 and sprints at 8, so a chase can be outrun.
    // Melee: a swing is a windup (a player can step out of reach in it), then the blow if the target is still within reach; interval_seconds is one swing's start to the next.
    "thief": {
      "hits": 20, "walk_speed": 1.8, "run_speed": 5.5, "hit_scale": 1.0,
      "melee": { "damage": 10, "reach_m": 2, "windup_seconds": 0.45, "interval_seconds": 1.0 }
    },
    "enforcer": {
      "hits": 35, "walk_speed": 1.6, "run_speed": 5.0, "hit_scale": 1.04,
      "melee": { "damage": 25, "reach_m": 2, "windup_seconds": 0.45, "interval_seconds": 1.0 }
    },
    "gang_boss": {
      "hits": 80, "walk_speed": 1.4, "run_speed": 4.5, "hit_scale": 1.15,
      "melee": { "damage": 10, "reach_m": 2, "windup_seconds": 0.45, "interval_seconds": 1.0 }
    },
    // What a hit counts besides a bullet (1). Run over by a vehicle: dead.
    "hits": { "headshot_weight": 2, "explosive_weight": 12, "vehicle_weapon_weight": 3 },
    // A player who hit any member of a Raid (bullet, headshot, explosive, vehicle weapon or ramming) is fought by the whole Raid for forget_seconds after their LAST hit (each hit starts it again), or until they die or are
    // give_up_m from every living member. Then the members go back to what they did: Thieves steal, Enforcers and the boss guard.
    "aggro": { "forget_seconds": 8, "give_up_m": 30 },
    "corpse_seconds": 10,
    // XP for killing a member (no kill feed, streak or assist).
    "kill_xp": 5,
    "turn_rate_deg_per_s": 360,
    // A chaser or follower asks for a new route at most every repath_seconds, and only when its goal is repath_m from the end of the route it has.
    "repath_seconds": 1.0,
    "repath_m": 3,
    // Members that walk are pushed apart when closer than separation_m (any Raid), at most separation_mps metres a second. Chasers of one player also take different spots on a ring round them.
    "separation_m": 0.8,
    "separation_mps": 2.0,
    // An Enforcer escorting a Thief stays within this of it.
    "guard_follow_m": 3.5,
    // A Thief with no Loot work (a gang the Raid gave none) idles for a random time, then walks to a point within wander_m of the Raid's post.
    "idle_min_seconds": 3,
    "idle_max_seconds": 8,
    "wander_m": 12,
    "walk_give_up_seconds": 20,
    // A fleeing member is removed at the map edge, after flee_seconds at the latest.
    "flee_seconds": 180,
    "edge_arrive_m": 3,
    // A member the van called back counts as boarded within this of its side door point.
    "board_reach_m": 1.5,
    // The dev fallback (no van yet): the crew appears on a road between min_m and max_m of the admin, spread_m round the point.
    "spawn": { "min_m": 25, "max_m": 60, "spread_m": 3 },
    // Client only (ticket 08): how a member is drawn. With the private Gang Warfare pack: the kind's model (the look number picks among a kind's models; "femn" lists the feminine bodies, where a clip name's {g} becomes
    // "femn" instead of "masc") in one of the 12 atlases (a uniform pick by the look number), the gang-rig clips below, the blows, climbing, the carry overlay and what it wears. Without the pack: a coloured capsule per kind.
    // An empty clip name plays nothing. Lengths are metres, times seconds.
    "view": {
      "models": { "gang_boss": ["gang_boss_01"], "enforcer": ["gang_enforcer_01"], "thief": ["gang_thief_01", "gang_thief_02"], "femn": ["gang_thief_02"] },
      "atlases": [
        "gang-warfare/textures/PolygonGangWarfare_01_A.png", "gang-warfare/textures/PolygonGangWarfare_01_B.png", "gang-warfare/textures/PolygonGangWarfare_01_C.png",
        "gang-warfare/textures/PolygonGangWarfare_02_A.png", "gang-warfare/textures/PolygonGangWarfare_02_B.png", "gang-warfare/textures/PolygonGangWarfare_02_C.png",
        "gang-warfare/textures/PolygonGangWarfare_03_A.png", "gang-warfare/textures/PolygonGangWarfare_03_B.png", "gang-warfare/textures/PolygonGangWarfare_03_C.png",
        "gang-warfare/textures/PolygonGangWarfare_04_A.png", "gang-warfare/textures/PolygonGangWarfare_04_B.png", "gang-warfare/textures/PolygonGangWarfare_04_C.png"
      ],
      // Run: chasing and boarding; sprint: fleeing and hauling. steal = kneeling at a target (the way down, then the loop; the pack's 7.5 s way up is never played: the next state blends out). The climbs play at the
      // speed of loot.climb_speed (see climb). hop_in / hop_out = the jump over a pet's fence, land = the landing after it. death: one by the look number (front, back, left).
      "clips": {
        "idle": "idle_standing_{g}_g", "walk": "walk_f_{g}_g", "run": "run_f_{g}", "sprint": "sprint_f_{g}",
        "steal": "kneel_enter_{g}", "steal_loop": "kneel_loop_{g}",
        "climb_up": "climb_up", "climb_down": "climb_down", "climb_work": "climb_work",
        "knockdown_begin": "knockdown_begin", "knockdown_loop": "knockdown_loop", "knockdown_end": "knockdown_end", "stun_loop": "stun_loop",
        "hop_in": "jump_running_{g}", "hop_out": "jump_running_{g}", "land": "land_soft_{g}",
        "death": ["death_front_sword", "death_back_sword_g", "death_left_sword_g"]
      },
      // blend_s: the crossfade between clips. steal_enter_seconds: the kneel's way down (3.2 s in the pack) is sped up to this. hop_seek_s / hop_speed: jump_running (2.4 s) is played from there at that speed over the
      // hop (loot.pet.hop_seconds); land_seconds: land_soft after it. get_up_seek_s: knockdown_end (4 s) lies until about 2.3 s then rises: played from there, sped up to loot.connector.get_up_seconds.
      "playback": { "blend_s": 0.2, "steal_enter_seconds": 1.0, "hop_seek_s": 0.5, "hop_speed": 1.5, "land_seconds": 0.5, "get_up_seek_s": 2.3 },
      // A windup is the server's telegraph (melee.windup_seconds), the blow lands at the start of the swing. The clip is started so its peak_s falls there; seek_s is where the clip's own motion starts
      // (swing_b and swing_c start held: their first second is the combo before). One of the list per swing (by look and swing count). The Enforcer swings the pipe, the others hit with the fist/shoulder.
      "blows": {
        "enforcer": [ { "clip": "swing_a", "seek_s": 0.07, "peak_s": 0.40 }, { "clip": "swing_b", "seek_s": 0.85, "peak_s": 1.10 }, { "clip": "swing_c", "seek_s": 1.45, "peak_s": 1.93 } ],
        "thief": [ { "clip": "pommel_strike", "seek_s": 0.53, "peak_s": 0.87 }, { "clip": "counter_shove", "seek_s": 0.53, "peak_s": 0.70 } ],
        "gang_boss": [ { "clip": "counter_shove", "seek_s": 0.53, "peak_s": 0.70 }, { "clip": "pommel_strike", "seek_s": 0.53, "peak_s": 0.87 } ]
      },
      // The climb clips (ours): wall plane wall_plane_m in front of the model's origin, one loop of a clip travels clip_speed_mps x its length (0.489 m/s), so a clip plays at loot.climb_speed / clip_speed_mps.
      // The server's member stands surface_m from what it climbs (loot.dish.base_out_m, loot.connector.base_offset_m: 0.9), so the body is slid (surface_m - wall_plane_m) towards it while it hangs on the wall.
      "climb": { "clip_speed_mps": 0.489, "wall_plane_m": 0.27, "surface_m": 0.9, "slide_seconds": 0.25 },
      // An idle Gang boss and an Enforcer on guard now and then play one of these (a drag, drink, for a member with a cigarette); a random time between min and max, never while fighting or walking. Client only.
      "gestures": { "taunts": ["taunt_laugh_point_{g}", "taunt_shake_fist_{g}", "taunt_beckon_{g}", "taunt_menacing_fists_{g}"], "drink": "drink_sip_{g}", "min_gap_seconds": 8, "max_gap_seconds": 25 },
      // What a member wears. offsets: metres in the rest pose's axes (the model faces +Z, up +Y, its right hand is -X) from the bone's origin; rotation_deg: Euler degrees. Nothing here was seen in the game: nudge freely.
      // pipe: the grip is in the hand bone's frame (position, rotation xyzw: Synty weapons have the blade along +Y, grip at the origin); the model is turned 180 degrees about Z and shifted 0.215 up its Y (pipe_01 spans y -0.566 to 0.335).
      // cigarette: the lit cigarette (0.147 m along +Z, filter at the origin) at the mouth, one member in one_in. speaker: speaker_01 (0.48 m tall) scaled down to about 0.2 m on the hip. chain: the Gang boss's gold chain
      // (the model of the Item in items.json, authored facing -Z) at the neck bone.
      "dress": {
        "pipe": { "model": "props/pipe_01", "atlas": "gang-warfare/textures/PolygonGangWarfare_01_A.png", "bone": "Hand_R", "position": [-0.0879, 0.0391, 0.0163], "rotation": [-0.4785, -0.3531, 0.3529, 0.7224], "model_rotation_deg": [0, 0, 180], "model_offset": [0, 0.215, 0] },
        "cigarette": { "model": "props/cigarette_lit_01", "atlas": "gang-warfare/textures/PolygonGangWarfare_01_A.png", "bone": "Head", "offset": [-0.025, 0.07, 0.1], "rotation_deg": [12, 0, 0], "one_in": 3 },
        "speaker": { "model": "props/speaker_01", "atlas": "glb/atlas/military_01_A.png", "bone": "Hips", "offset": [-0.25, 0, 0], "rotation_deg": [0, 0, 0], "scale": 0.42 },
        "chain": { "bone": "Neck", "offset": [0, 0, 0], "rotation_deg": [0, 180, 0], "scale": 1.0 }
      },
      // The carry overlay: while a member carries Loot the arms of the pose (right/left hand goal in the rest pose's axes; elbow_down/elbow_out weight where the elbow bends; hand_roll_deg turns the palm inwards) are blended
      // over its clip (blend_s fades), the prop of the kind is held at prop_at (the middle of the prop). two_hands: tire, dish. under_arm: the pet is its own entity the server holds at loot.pet carry_right_m / carry_up_m /
      // carry_forward_m: the right hand goes there plus pet_offset (right, up, forward of the member). one_hand: connector. model/atlas: the pack's model for the prop (the tire; the connector stays the generated insulator
      // fitting, which reads as a pole's connector: props/downpipe_connector_01 is a rain gutter piece; name it here, with atlas "glb/atlas/military_01_A.png", to try it). The dish is always the generated model.
      "carry": {
        "blend_s": 0.2, "chest_bone": "Spine_03",
        "poses": {
          "two_hands": { "right": [-0.30, 1.05, 0.34], "left": [0.30, 1.05, 0.34], "elbow_down": 1.0, "elbow_out": 0.5, "hand_roll_deg": 90 },
          "under_arm": { "pet_offset": [-0.08, 0.1, -0.08], "elbow_down": 1.0, "elbow_out": 0.8, "hand_roll_deg": 0 },
          "one_hand": { "right": [-0.27, 0.92, 0.18], "elbow_down": 1.0, "elbow_out": 0.6, "hand_roll_deg": 0 }
        },
        "kinds": {
          "tire": { "pose": "two_hands", "prop_at": [0, 1.05, 0.36], "model": "props/tire_01", "atlas": "glb/atlas/military_01_A.png" },
          "dish": { "pose": "two_hands", "prop_at": [0, 1.05, 0.38] },
          "pet": { "pose": "under_arm", "prop_at": [0, 1.05, 0.38] },
          "connector": { "pose": "one_hand", "prop_at": [-0.27, 0.86, 0.18] }
        }
      },
      "thief_color": "#7d6b4f", "enforcer_color": "#8a3b32", "gang_boss_color": "#c9a227", "capsule_height_m": 1.8
    }
  },
  // The convoy: one wave of vans. vans = a random number from min_vans to max_vans; the first is launched at once, each next convoy_gap_seconds after the one before (they drive the same
  // route in a line at the van's speed: 3 s is about 40 m apart) and park at different stops near the church, which splits them. The event is won when every van of the wave is gone. Each van's crew grows by
  // one extra member for every players_per_extra players beyond the first: Thieves first (up to max_extra_thieves), then Enforcers (up to max_extra_enforcers).
  "raids": {
    "min_vans": 1, "max_vans": 3, "convoy_gap_seconds": 3,
    "players_per_extra": 2, "max_extra_thieves": 3, "max_extra_enforcers": 1,
    // Fixed routes: the only ways a van comes in and leaves by (each wave picks one at random, all its vans take it; route_pick "random" is the only way). Waypoints [x, z] in the map's local ground metres (x east, z south = the
    // axes of roads.json with y flipped), in the order driven. THE VILLAGE MAP'S: sketch points A B C and D E F G H of the map editor (S-JTSK minus the map origin, z = -(y - origin y)), placed by the owner.
    // The van appears at the first waypoint, drives the roads through them (each snapped to the nearest road within route_snap_max_m, on roads of any width from route_min_road_width_m: route 2's G to H is a 1.5 m footpath), carries on from the last one along the main road to a stop within
    // park_near_church_m of the church (church.json doorway; park_centre [x, z] overrides it, for a map without a church) and leaves by the same roads backwards, gone at the first waypoint. A route this map
    // cannot drive is skipped (logged); none usable (or none listed): the old automatic way in from the map edge. Without a centre the van parks at the end of its route (route_stop_search_m back along it if the spot fails).
    "route_pick": "random", "route_snap_max_m": 30, "route_min_road_width_m": 0, "park_near_church_m": 100, "route_stop_search_m": 40,
    "routes": [
      { "name": "route 1 (A B C)", "waypoints": [[191.61, 1663.37], [104.11, 890.37], [16.11, 122.37]] },
      { "name": "route 2 (D E F G H)", "waypoints": [[-264.89, 1266.37], [-104.39, 820.37], [7.11, 354.87], [-36.39, 95.37], [10.11, 81.37]] }
    ]
  },
  // The Raid van (ADR 0021): a scripted entity, not a vehicle. It never brakes for what is in its way. Hit count: a bullet 1, a headshot is a body hit, explosive and vehicle weapon the weights.
  "van": {
    "speed_mps": 13, "park_speed_mps": 1.5, "accel_mps2": 4, "decel_mps2": 4, "turn_deg_per_s": 110,
    "hits": 300,
    "hit": { "headshot_weight": 1, "explosive_weight": 25, "vehicle_weapon_weight": 6 },
    // The hit volume: two prone capsules grown by hit_scale (radius 0.56 x 2.2 = the model's half width), hit_offset_m ahead of and behind the centre (the capsule ends then reach the model's 2.38 m).
    "hit_scale": 2.2, "hit_offset_m": 0.4,
    // The box: what rams, what shoves vehicles aside, what a parked van is solid with. The model's (vehicles/raid_van.glb, 2.417 x 4.753 x 1.860 m): the data follows the model, not the other way round.
    "half_width_m": 1.21, "half_length_m": 2.38, "height_m": 1.86,
    // Loot it takes before it leaves, the longest stay after it stopped, how long it waits for the crew it called back.
    "capacity": 8, "stay_seconds": 240, "board_wait_seconds": 25,
    "door_seconds": 1.5, "crew_stagger_seconds": 0.8, "wreck_seconds": 25,
    // The side door: how far outside the van's side the crew steps out, and how far ahead of the centre (0.07: the middle of the model's doorway).
    "door_out_m": 1.1, "door_along_m": 0.07,
    "honk_min_seconds": 9, "honk_max_seconds": 22, "honk_near_m": 25, "honk_near_gap_seconds": 6,
    // Roads at least min_road_width_m wide. Stop = the candidate (every stop_step_m, stop_inset_m inside the map) with most targets within stop_radius_m, not within used_apart_m of an earlier stop.
    "min_road_width_m": 3, "stop_radius_m": 80, "stop_step_m": 20, "stop_inset_m": 30, "used_apart_m": 60,
    // Turning round on the way out costs this much extra; with no road out it drives this far straight on.
    "u_turn_penalty_m": 150, "exit_straight_m": 150,
    // Ramming: its mass over a car's for the run-over damage of vehicles.json, and the damage when there is no such table.
    "ram_mass_scale": 3, "ram_fallback_damage": 100,
    // Client only. With the private Military pack: model (glb/vehicles/raid_van.glb, +Z forward, origin at the middle on the ground, the right-hand sliding door a node "door") in its atlas; the door node slides from
    // door_closed to door_open (the model's own coordinates) by the door fraction; a left door is the mirrored model; model_lift_m lifts it (its wheels reach 0.10 m under the origin). The wreck: paint x wreck_tint, each
    // damage stage dims the paint by stage_dim. Without the pack a box van of boxes and cylinders in the colours; honk_hear_m is how far from the camera a honk is heard, honk_db its loudness on top of the sound's own (+6), honk_fade_db how much quieter it is at that distance.
    "view": {
      "model": "vehicles/raid_van", "atlas": "glb/atlas/military_land_vehicle_01_burnt.png", "door_node": "door",
      "door_closed": [-0.722, 0.763, 0.068], "door_open": [-0.842, 0.763, -0.932], "model_lift_m": 0.0, "wreck_tint": "#3a3532", "stage_dim": 0.07,
      "body_color": "#b9b3a2", "cab_color": "#8c3f33", "door_color": "#9b9585", "wreck_color": "#2b2724", "honk_hear_m": 360, "honk_db": 6, "honk_fade_db": 12
    }
  },
  // Ticket 09. Voice lines (server): a living member not in a windup or swing with a human within voice_near_m rolls voice_chance every voice_roll_s; a member that spoke waits
  // voice_cooldown_s; one line at a time per Raid (voice_busy_s, the server does not know how long a line is). voice_lines = recordings the server picks from; the client plays line mod files found.
  // Ranges are client only: voice_range_m, speaker_range_m (a member's speaker), van_range_m and van_volume_db (a van's song: how far it is heard and how loud, dB). speaker_chance is rolled once per member.
  // Files (private, optional): assets-private/audio/thieves/voice/*.ogg and songs/*.ogg; none found = silence.
  "audio": {
    "voice_near_m": 8, "voice_chance": 0.3, "voice_roll_s": 2, "voice_cooldown_s": 15, "voice_busy_s": 3, "voice_lines": 15, "voice_range_m": 25,
    "speaker_chance": 0.05, "speaker_range_m": 30, "van_range_m": 120, "van_volume_db": 8
  },
  // The reward (ticket 10). Everyone credited (hit a Gang member or a van, or sent Loot back) gets the level data's event_win XP when the event is won.
  // chain_item: the items.json id a killed Gang boss leaves on his body; chain_corpse_seconds: how long that body lies. A boss who leaves alive keeps his.
  "reward": { "chain_item": "gold_chain", "chain_corpse_seconds": 300 },
  // Ticket 04. How the Thieves steal and how Loot is sent back, then one sub-section per kind of Loot (each later ticket edits only its own).
  // A Thief looks for a target within seek_radius_m of the van and picks a kind by weight (0: never), then the nearest target of it; one Thief per target. It walks to it at approach_speed_mps (giving it up
  // after approach_give_up_seconds, or at once with no route, and not choosing it again for avoid_seconds), works steal_seconds (pickup_seconds on Loot that lies), carries it to the van's door at
  // haul_speed_mps (drops it after haul_give_up_seconds) and tosses it in (load_seconds, within load_reach_m of the door). climb_speed: how fast a Thief climbs up and down for a target that needs a climb.
  // Loot that lies (its carrier was killed): at most max_lying (over it the oldest goes back by itself); a player holds use return_seconds within reach_m of it to send it back; moving off or a hit starts it over.
  "loot": {
    "max_lying": 24, "return_seconds": 1.0, "reach_m": 1.8,
    "seek_radius_m": 90, "seek_retry_seconds": 2, "approach_speed_mps": 3.0, "haul_speed_mps": 4.5, "arrive_m": 1.0,
    "approach_give_up_seconds": 45, "avoid_seconds": 60, "haul_give_up_seconds": 60, "pickup_seconds": 1.0, "load_seconds": 0.6, "load_reach_m": 1.5,
    "climb_speed": 1.5,

    // Vehicles are the priority: a Thief picks a tire still on a car before any other kind (the nearest one), and a car at rest with a wheel on that newly comes within arrive_radius_m of a Raid's van
    // (0: seek_radius_m; a spawn, a respawn, a player stopping one there) sends thief_share of the Raid's free Thieves (not carrying, not working; rounded up, at least one) to its tires, at most
    // max_thieves_per_vehicle (one per wheel, 1 to 4). The server looks every check_seconds; a car stays handled until it leaves the radius (or is driven off) and returns.
    "vehicle_priority": { "thief_share": 0.5, "max_thieves_per_vehicle": 4, "check_seconds": 1.0, "arrive_radius_m": 0 },

    // Tires (ticket 04): one target per wheel of a car at rest, of the vehicle types listed (the sedan model, whose wheel nodes the client hides). The wheel centres are wheel_side_m either side of
    // the car's middle and wheel_end_m ahead of and behind it; the Thief kneels work_side_m out beside the wheel. At rest: nobody inside and slower than rest_speed_mps.
    "tire": { "weight": 1, "steal_seconds": 6, "vehicle_ids": ["car"], "wheel_side_m": 0.72, "wheel_end_m": 1.12, "work_side_m": 1.9, "rest_speed_mps": 0.5 },

    // Pets (ticket 05): one target per living pet no Thief holds. A pet behind a fence is reached by a hop: the Thief stands hop_out_m outside the nearest section, jumps over it (hop_seconds, the arc clears the
    // fence by hop_clear_m) to hop_in_m inside, walks to the pet (in_walk_speed_mps; grabs within grab_m, then steal_seconds), and hops back out with it. A garden with no fence is a plain walk. The pet is
    // held at the Thief's right (carry_right_m), carry_forward_m ahead, carry_up_m up. fence_candidates: how many of the nearest sections are tried for a hop point on the navigation mesh (nav_snap_m);
    // plan_recheck_m: a plan is kept until the pet has moved this far.
    "pet": {
      "weight": 1, "steal_seconds": 4,
      "hop_seconds": 0.7, "hop_out_m": 0.9, "hop_in_m": 0.9, "hop_clear_m": 0.5, "in_walk_speed_mps": 3.0, "grab_m": 0.8,
      "carry_right_m": 0.4, "carry_forward_m": 0.25, "carry_up_m": 0.8,
      "fence_candidates": 6, "nav_snap_m": 1.5, "plan_recheck_m": 2.0
    },

    // Dishes (ticket 06): the placed objects with the generated dish model. The Thief stands base_out_m out from the dish along the way the wall faces, on the ground and on the navigation mesh (a base
    // more than snap_max_m (flat) or snap_max_dy_m (height) from the mesh makes the dish no target), climbs straight up to reach_below_m under the dish's origin (at least min_climb_m up), works there.
    "dish": { "weight": 1, "steal_seconds": 8, "base_out_m": 0.9, "snap_max_m": 1.2, "snap_max_dy_m": 1.0, "reach_below_m": 1.3, "min_climb_m": 0.4 },

    // Connectors (ticket 07): one target per placed pole with wires. The Thief climbs to the top (the highest wire seat; 90 % of the height without one), works steal_seconds, climbs down with a
    // connector. Nothing goes missing on the pole; it can be robbed again after pole_cooldown_s. Reaching the top rolls electrocute_chance: Shocked shock_seconds (beams and sound), Falling,
    // Down down_seconds (lying), GetUp get_up_seconds, then the same pole again; no hits lost. The climb's base is a navigation point base_offset_m beside the column.
    "connector": {
      "weight": 1, "steal_seconds": 6, "pole_cooldown_s": 120,
      "electrocute_chance": 0.05, "shock_seconds": 2.0, "down_seconds": 4.0, "get_up_seconds": 1.2,
      "base_offset_m": 0.9, "top_fraction": 0.9
    }
  }
}
