{
  "version": 1,
  // The Bigfoot event (issue #264): every number of the fight. Lengths are metres, speeds metres per second, times seconds.
  // These are first guesses made by reading, not by playing: the fight is meant to take about a minute and has never been run.
  // `/event bigfoot` starts it (admin), `/event current end` wins it, `/event current cancel` removes it with no reward.

  // The placeholder art: Quaternius "Giant" (rigged, 12 joints; clips Attack, Death, HitRecieve, Idle, Jump, Run, Walk).
  // model_scale brings the imported model (4.53 units tall as Godot imports it, measured with the asset check; feet at y 0.03) to
  // height_m, twice a player (1.8 m); the model faces +Z, so 180.
  "model": "quaternius-giant/giant.glb",
  "model_scale": 0.8,
  "model_yaw_deg": 180,
  "height_m": 3.6,
  // The hit volume is the player's capsule (HitMath) grown by this much: 2 = twice as tall and as wide. A headshot is a body hit.
  "hit_scale": 2,

  // Everything it does to a player (a log, the shockwave, a landing, what the launched player hits) is a whole number in this range.
  "damage_min": 2,
  "damage_max": 5,

  // The damage model is a hit count, not hit points. It dies after hits.per_player x participants hits, the participants being the
  // living players within participant_radius_m (at least min_players; the count only goes up while it fights). A bullet hit counts 1,
  // a headshot no more, a pellet fan that hits it counts 1; an explosive or vehicle-weapon hit counts its weight. Ramming it does nothing.
  "hits": {
    "per_player": 300,
    "min_players": 1,
    "participant_radius_m": 90,
    "explosive_weight": 25,
    "vehicle_weapon_weight": 4,
    // fractions of the hit count taken: phase two adds the stomp and the vehicle throw, phase three the grab and the launch,
    // and past enrage_at it is faster and its cooldowns are shorter
    "second_phase_at": 0.30,
    "third_phase_at": 0.60,
    "enrage_at": 0.85,
    // the same steps by the clock, whichever comes first: seconds of the fight (awake, with a target) after which each begins even
    // if nobody shot it (0: never by time)
    "second_phase_after_seconds": 20,
    "third_phase_after_seconds": 45,
    "enrage_after_seconds": 90,
    "enrage_speed_multiplier": 1.3,
    "enrage_cooldown_multiplier": 0.6,
    "health_regain_per_second": 0
  },

  // It ignores the navmesh: a straight line over the terrain towards the nearest player, kept for retarget_seconds. Trees are no
  // obstacle (it tramples through them); buildings and walls are solid, and it goes round them.
  "movement": {
    "walk_speed": 3.4,
    "run_speed": 13.9,
    "run_beyond_m": 16,
    "turn_rate_deg_per_s": 150,
    "max_step_m": 1.4,
    "body_radius_m": 1.1,
    "retarget_seconds": 4,
    "stop_distance_m": 3,
    // a player farther than this is no target: it gives a runner up and stands until someone is nearer
    "give_up_m": 150
  },

  // Phase one: it hurls tree trunks, an arc aimed ahead of the target.
  "trunk": {
    "min_range_m": 2.5,
    "max_range_m": 55,
    "cooldown_seconds": 3.2,
    "windup_seconds": 0.8,
    "speed_mps": 24,
    "radius_m": 0.6,
    "life_seconds": 6,
    "aim_lead_seconds": 0.35
  },

  // Phase two: the stomp. The wind-up is the telegraph (animation and sound); the shockwave then runs outwards along the ground
  // and knocks back every player standing on it once. A player whose feet are more than wave_height_m up when it passes (a jump) is untouched.
  "stomp": {
    "trigger_m": 10,
    "cooldown_seconds": 7,
    "windup_seconds": 1.1,
    "wave_speed_mps": 14,
    "wave_max_radius_m": 24,
    "wave_band_m": 1.6,
    "wave_height_m": 0.5,
    "knockback_mps": 9,
    "knockback_lift_mps": 4.5
  },

  // Phase two: a ground vehicle it is in contact with is taken in both hands, lifted hold_height_m over its feet (above its head) during
  // the wind-up, and thrown from there on a scripted arc to a random place; nothing aboard takes damage, the driver's input is ignored
  // from the lift to the landing.
  "vehicle_throw": {
    "contact_m": 4.5,
    "windup_seconds": 1.6,
    "hold_height_m": 4.2,
    "cooldown_seconds": 4,
    "min_distance_m": 25,
    "max_distance_m": 60,
    "flight_seconds": 2.4,
    "spin_rad_per_s": 2.5,
    "placement_tries": 8
  },

  // Phase three: it picks a player on foot up, flails with them for hold_seconds and launches them, aimed at another player when there is one.
  "grab": {
    "range_m": 4.5,
    "cooldown_seconds": 11,
    "reach_seconds": 0.7,
    "hold_seconds": 2.5,
    "launch_flight_seconds": 2.4,
    // with nobody else to aim at the throw goes random_launch_speed_mps x launch_flight_seconds far (60 m); another player nearer than
    // min_launch_distance_m only gives the direction and the thrown one lands that far away
    "random_launch_speed_mps": 25,
    "min_launch_distance_m": 45,
    "launch_grace_seconds": 5,
    "launch_hit_radius_m": 1.3,
    "hand_height_m": 2.7,
    "hand_forward_m": 1.4
  },

  // When every participant dies it heals to full and waits where it stands until a player comes within wake_radius_m. With no living
  // player within despawn_radius_m for despawn_minutes it despawns, with no reward.
  "wipe": {
    "wake_radius_m": 60,
    "despawn_minutes": 10,
    "despawn_radius_m": 250
  },

  // The reward: the "event won" line and XP for everyone credited (levels.json awards.event_win), then its body is gone and footsteps
  // lead from where it fell to a corpse that carries the item. A player who hit it credit_min_hits times, or a living one within the
  // participant radius when it fell, is credited.
  "reward": {
    "head_item": "bigfoot_head",
    "corpse_seconds": 900,
    "death_seconds": 3,
    "trail_length_m": 120,
    "trail_spacing_m": 1.9,
    "trail_tries": 24,
    "credit_min_hits": 3
  },

  // A dev aid: a map with no area that carries "event spawn: bigfoot" has no spawn point for it, so /event bigfoot puts it this far from a
  // random living player instead (and says so to the admin and in the log).
  "fallback_spawn": {
    "min_distance_m": 55,
    "max_distance_m": 85
  }
}
