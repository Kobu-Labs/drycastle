{
  "version": 1,
  // Wildlife: wild animals (GLOSSARY "Wildlife") that stand in the zones of their species' kind (zone kinds deer, boar, ...; rules.yaml zones,
  // baked into the map's candidate points, zone_points.json). Each round starts with "count" of each species, at random habitat points; nothing replaces one that is
  // shot (but see "rare"). A species with no habitat point in the map gets none. "max_animals" caps all wildlife at once; wildlife, pets, poop and everything else share
  // the world's entity cap (512). Species are ids of animals.json that flee (a pet is placed by pets.json).
  // A species with "herd" gathers into herds of min..max animals: they start within spread_m of one habitat point, wander about the herd's centre,
  // the centre drifts within range_m of that point every move_min_seconds..move_max_seconds (defaults 30..90) while calm, and when one animal
  // takes fright the whole herd runs from the same spot. A count not a multiple of the herd size ends in a smaller herd. No "herd": solitary.
  // "herds" are mixed herds, of more than one species (GLOSSARY "Herd"): "count" animals in all, in herds of size min..max. Each herd rolls its size, then its
  // counted members (a member with "min".."max": 1-3 stags, never more than size - 1), then fills the rest by "weight" of the other members. All the
  // members stand in one zone kind, "habitat" (default: the first weighted member's id). The herd moves like any other (spread_m, range_m, move_*).
  // Members are ids of animals.json that flee, and are not also listed under "species" (their counts would add up).
  // "rare" species (GLOSSARY "Unicorn"): not zone species (no habitat points). "count" of them live on the whole map at once, each at a random point anywhere with
  // ground (not water, not steep) that is at least "min_building_m" (default 60) from every building (a parcel that holds one). A killed one is replaced by a new one at a
  // new random point "respawn_seconds" (default 60) after the kill; a search that finds no point (200 tries) is tried again after another "respawn_seconds". Round start puts the first.
  // A rare animal counts toward "max_animals" and the entity cap, is placed before the other species, and is an id of animals.json that flees. It is never announced and is no Event.
  // "phoenix" (GLOSSARY "Phoenix"): the rare Mystery animal of the night sky, an id of animals.json with "flies": true. A night is counted each time the server's day clock passes
  // "spawn_hour" (0 = midnight); every "nights_between"th (5) night, at that hour, one Phoenix appears (the first on the 5th night) if none is still alive and a round is running. The count is the server's own
  // and is not reset by a round; a stopped clock (/time freeze) never passes midnight. It flies a circle of "patrol_radius_m" (cut to fit the map) at "speed_mps", its body centre
  // "altitude_min_m".."altitude_max_m" above the ground. The first hit that deals damage (any weapon; nothing hits it with a knife: too high) makes it fall for "fall_seconds" along a straight line to a crash site, a
  // clear patch of ground 40-120 m from where it was hit: a free circle of "crash_clear_m" (3: 6 m across), ground all over it no more than "crash_max_slope_m" higher or lower than its middle, nothing solid in it,
  // at least "crash_building_m" from every building. It sits there, alive, until a second hit (only then) burns it for "burn_seconds"; then it is dead, lies as ash for corpse_seconds and leaves the
  // mineral "drops" (a Minerals id) where it burned. At "dawn_hour" a Phoenix still flying flies off; a crashed one stays until killed or the round ends. It counts toward max_animals.
  "phoenix": { "id": "phoenix", "nights_between": 5, "spawn_hour": 0, "dawn_hour": 5, "altitude_min_m": 80, "altitude_max_m": 140, "patrol_radius_m": 350, "speed_mps": 14,
               "fall_seconds": 4, "crash_min_m": 40, "crash_max_m": 120, "crash_clear_m": 3, "crash_max_slope_m": 0.9, "crash_building_m": 10, "burn_seconds": 6, "drops": "pheonixite" },
  "max_animals": 160,
  "rare": [
    { "id": "unicorn", "count": 1, "min_building_m": 60, "respawn_seconds": 60 }
  ],
  "herds": [
    { "id": "red_deer", "count": 78, "habitat": "deer", "size": { "min": 5, "max": 9 }, "spread_m": 15, "range_m": 80,
      "members": [ { "id": "stag", "min": 1, "max": 3 }, { "id": "deer", "weight": 3 }, { "id": "doe", "weight": 1 } ] }
  ],
  "species": [
    { "id": "moose", "count": 4 },
    { "id": "boar", "count": 12, "herd": { "min": 3, "max": 5, "spread_m": 8, "range_m": 40 } },
    { "id": "bear", "count": 4 },
    { "id": "fox", "count": 8 },
    { "id": "wolf", "count": 6, "herd": { "min": 2, "max": 4, "spread_m": 10, "range_m": 80 } },
    { "id": "rabbit", "count": 20, "herd": { "min": 3, "max": 6, "spread_m": 6, "range_m": 25 } },
    { "id": "raccoon", "count": 8 },
    { "id": "skunk", "count": 6 }
  ],
  // Bird flocks: flying boids, cosmetic (not animals: no hit points, cannot be shot). Each flock is one world entity that flies a tour of waypoints
  // within range_m of its habitat point (the ground attribute value "wildlife:<id>", like a species) at altitude_min_m..altitude_max_m above the ground and
  // scatters from a player or moving vehicle within scatter_radius_m; the birds are boids every client flies around it (the "boids" numbers: defaults
  // shown in BoidRules); they flow round aircraft (the gunship aircraft and flying vehicles) and never fly through one. "model" is a GLB of assets/ or assets-private/ (a small wedge when it is missing); model_yaw_deg turns it to face forward.
  "flocks": [
    { "id": "crow", "name": "Crows", "model": "animal-kit/bird.glb", "scale": 1, "model_yaw_deg": 180,
      "flocks": 15, "birds_min": 24, "birds_max": 48, "altitude_min_m": 18, "altitude_max_m": 40, "range_m": 200, "speed_mps": 7, "scatter_radius_m": 30 }
  ]
}
