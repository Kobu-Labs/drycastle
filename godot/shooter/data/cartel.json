{
  "version": 1,
  // The drug Cartel (docs/cartel.md, ADR 0046; GLOSSARY "Cartel", "Cartel rank", "Respect", "Job"). Read by ShooterCore/Cartel/CartelFile.cs; nothing here was played: first guesses.
  // ranks: the personal ladder, lowest first. respect: the total Respect a member needs to hold the rank (the first is 0, each next more). Respect only grows; a member who
  // quits keeps it frozen until they rejoin. The name is what players see (the rank-up toast); the id is the key tiers name.
  "ranks": [
    { "id": "runner",  "name": "Runner",  "respect": 0 },
    { "id": "dealer",  "name": "Dealer",  "respect": 1000 },
    { "id": "sicario", "name": "Sicario", "respect": 3000 },
    { "id": "capo",    "name": "Capo",    "respect": 7000 },
    { "id": "patron",  "name": "Patrón",  "respect": 15000 }
  ],
  // tiers: the Contact lists jobs by tier, 1 first, numbered without a gap. rank: the lowest rank of the leader that opens it (never lower than the tier before's);
  // respect: what a finished job of the tier pays EVERY earning member of the party at the moment of success (a member of the Cartel with a stored Profile, not in sandbox mode).
  // A failed job pays nothing. Reward depends on the tier only; a heist adds its own bonus (jobs.<heist>.bonus_respect_per_duffel).
  "tiers": [
    { "tier": 1, "rank": "runner",  "respect": 100 },
    { "tier": 2, "rank": "dealer",  "respect": 200 },
    { "tier": 3, "rank": "sicario", "respect": 350 },
    { "tier": 4, "rank": "capo",    "respect": 550 },
    { "tier": 5, "rank": "patron",  "respect": 800 }
  ],
  // contact_reach_m: how near the Contact (ground metres) a player must stand to join, quit or start a job (the map's placed Contact; a map without one has no Cartel).
  "contact_reach_m": 3,
  // marker_resend_m: a Job's marker (the HUD's minimap and world marker for its party) is sent again only once its point has moved this many metres (0: every change).
  "marker_resend_m": 2,
  // pallet (CartelPalletData, ShooterCore/Cartel/CartelPallet.cs): the Cartel pallet a Delivery's Duffel lies on. It stands where the first placed object of the marker prim:cartel_pallet stands (set
  // by hand in the map editor, Objects tool, category other, a few metres from the Contact); a map without one has no Delivery. The marker is solid like any placed prop (a low box the pallet's
  // size); the game hides it and draws the Gang Warfare pallet there. spots: one [x, z] per bag spot, metres from the pallet's centre in its own frame (x along its width, z along its depth, before
  // its turn); a Delivery holds one while it runs, so there are as many Deliveries at once as spots ("The pallet is full" past that). top_m: the deck's height above the base, where a bag lies.
  // size_m [x, y (up), z] is the model's, read from SM_Prop_Pallet_01.glb (the marker primitive in pipeline kits/primitives.py has the same footprint); it only feeds the box drawn without the
  // private pack, in colour. model: under assets-private/synty/glb (no .glb), atlas: under synty/.
  "pallet": {
    "top_m": 0.235,
    "spots": [[-0.36, -0.33], [0.36, -0.33], [-0.36, 0.33], [0.36, 0.33]],
    "model": "gang-warfare/SM_Prop_Pallet_01",
    "atlas": "gang-warfare/textures/PolygonGangWarfare_01_A.png",
    "size_m": [1.441, 0.235, 1.418],
    "colour": "#8a6a45"
  },

  // assault_car (AssaultCarData, ShooterCore/Cartel/AssaultCar.cs; AssaultFleet, ChaseUnit on the server; docs/cartel.md "Assaults"; GLOSSARY "Assault"): an Assault is a Rival crew van that drives like a chase car (the
  // same NPC driver and machine, Chase.Car; it drives on the Heist's own "chase" numbers: max_speed_mps, follow_m, shoot_range_m, stop_speed_mps, stop_within_m, remount_*, repath_seconds ...) after the Cartel van itself, over the
  // roads and open ground (see off_road). vehicle_type / skin: the vehicles.json type and its skin index; the Cartel van's skin 0 is the player's white one, skin 1 the dark one (scripts/vehicles/specs/cartel_van.json skins:
  // Gang Warfare Vehicle_05, the lowest mean luminance of Vehicle_01..06 over the van body's own atlas texels, area-weighted, 0..255: 01 92.9, 02 93.6, 03 91.6, 04 95.0, 05 48.7, 06 48.8; chosen as the chase car's red was).
  // CREW: assault_enforcers / assault_gunmen of the heist (1 Enforcer at the wheel, 4 Gunmen, up to max_crew 6): the cab has two seats (the driver, one Gunman who shoots from the window); the others ride seated in the cargo bay on
  // bay_posts and do not shoot while they ride; when the van stops they step out behind it (the rear doors: the post's x, bay_exit_z_m along the van's frame) and fight on foot as a Rival crew, and walk back to those points to get in again.
  // bay_posts: points on the bay floor in the VEHICLE's frame (x right, y up, z towards the rear; metres from the vehicle's ground centre), taken from scripts/vehicles/specs/cartel_van.json: the bay floor is y 0.73, the bulkhead
  // src z 0.271, the rear doors' hinge src z -2.295 (source frame: faces +Z); the standardizer's game frame is z = 0.074 - src z and x mirrored, so the bay runs from z -0.197 to 2.369 (vehicles.json cargo_volume: x +-0.77),
  // the cab seats at z -0.586. Two rows (z 0.45 and 1.35), 0.5 either side of the middle. The figure sits with its hips seat_pelvis_m (0.42) above its feet, so the posts are on the floor (the seat's own point is lowered by chase seat_drop_m).
  // bay_exit_z_m 3.6: 1.07 behind the van's tail (2.53). WHERE: a road or open drivable ground point whose drivable way to the Cartel van (the length of the way it would drive: off_road's plan) lies in a band [min, max] of spawn_bands_m,
  // at least spawn_player_min_m from every player, spawn_apart_m from the other Rival vehicles, clear of vehicles; NO out-of-sight rule (the drive in is the warning). Road points every spawn_road_step_m, open ground points on rings
  // spawn_ring_step_m apart every spawn_ring_step_deg round the van (where a van of spawn_half_width_m can stand); at most spawn_checks (12: each is a road and open ground route plan) candidates have their way worked out, in random order, ONE budget for all the bands together (a band that uses it up leaves none to the wider ones). The first band is the wanted
  // 250 to 400 m; when no point fits it the next, wider band is tried (200-600, then 100-600), so an Assault is sent rather than none; the log says which band and why a send failed. GIVE UP: give_up_m 600 for give_up_seconds
  // (the chase car's 250 would fire at once from a 250-400 m spawn); no band's max may be past give_up_m (checked), or a van put down there would give up at once. The Assault van drives on the chase numbers, far_m / far_speed_mps included
  // (120 km/h more than 100 m behind the Cartel van; the Cartel van type's own top speed is 33, so it just reaches it). When its crew is on foot it heads for the objective's centre (snapped onto the navigation mesh) while the Heist is at the objective, else for the Cartel van (on the road, at the drop). STALLED: the newest Assault whose crew still rides in its vehicle and that got no stall_progress_m (10) closer to the van in stall_seconds (10) (within stall_near_m (40)
  // of it is close enough: it is on the van's tail) is stalled: the next Assault is sent right away (the interval starts over from it), it no longer counts towards max_assaults_alive, and it is removed with its crew once it is more than
  // remove_far_m (150) from every player and no player can see it (a line of sight, as a Gunman's; looked at every remove_check_seconds).
  "assault_car": {
    "vehicle_type": "cartel_van",
    "skin": 1,
    "spawn_bands_m": [[250, 400], [200, 600], [100, 600]],
    "spawn_player_min_m": 150,
    "spawn_apart_m": 25,
    "spawn_road_step_m": 30,
    "spawn_ring_step_deg": 20,
    "spawn_ring_step_m": 50,
    "spawn_checks": 12,
    "spawn_half_width_m": 1.45,
    "give_up_m": 600,
    "give_up_seconds": 20,
    "stall_progress_m": 10,
    "stall_seconds": 10,
    "stall_near_m": 40,
    "remove_far_m": 150,
    "remove_check_seconds": 1,
    "bay_posts": [[-0.5, 0.73, 0.45], [0.5, 0.73, 0.45], [-0.5, 0.73, 1.35], [0.5, 0.73, 1.35]],
    "bay_exit_z_m": 3.6
  },

  // off_road (OffRoadData, ShooterCore/Cartel/OffRoad.cs; docs/cartel.md "Assaults", "Chase cars"): how the Rival crew's vehicles (Assault vans, chase cars) leave the roads. They use the roads while the roads bring them closer
  // and cross open ground (fields, meadows) when that is shorter, never over a building, a tree trunk, a fence, water or a slope steeper than max_grade. A plan is the cheapest of: straight (cost open_cost per metre; a metre of road
  // costs 1, so roads win unless the field is clearly shorter), or join the nearest road within enter_m (the line to it open) and leave it at the road point within leave_m of the goal (one every step_m, at most max_checks tried) whose
  // line to the goal is open. close_m: within this of its end a line is not looked at. The open check (the server's
  // OpenGround) looks at a line every sample_m in three lanes the vehicle's width wide (its half width plus margin_m) with rays ray_up_m over the ground; car_half_width_m is the car's, for a spot to stand on.
  "off_road": {
    "enter_m": 80, "leave_m": 300, "step_m": 15, "open_cost": 1.3, "close_m": 6, "max_checks": 10,
    "sample_m": 4, "ray_up_m": 0.9, "max_grade": 0.45, "margin_m": 0.3, "car_half_width_m": 1.1
  },

  // job_done_cinematic (JobDoneCinematicData, ShooterCore/Cartel/JobDoneCinematic.cs; docs/cartel.md "Job done"): what a party player sees and hears when their Job succeeds, on their own client only. A short cinematic of
  // about 10 s: the banner (banner_seconds), the camera leaving the body in quick eased moves out to a high view (legs; each move starts a soft white flash, then the camera holds and drifts), then a flashed cut back into the player's view, the
  // player's own music under it. Nothing here was played: first guesses.
  // stages: where the camera stands. anchor: player (the body, or the vehicle it rides) or party (the centre of the party's living squad mates within party_radius_m of the player, the player alone with none).
  // back_m behind the view's heading (as it was when the cinematic began) and up_m above the anchor's feet; it looks at look_up_m above the anchor. During its hold it pushes in drift_push_m and turns drift_turn_deg
  // round the anchor (left positive). clamp: pull_in (a wall in the way brings the camera in along its line: the low view behind the player) or raise (the camera stays on its line: the high views). Either way
  // the camera is kept clearance_m above the ground and above any roof over it ("raise it, never through a roof").
  // legs, in order: move to the stage (to, a stage id; "eye" is the player's own view) in move_seconds (fast at first, settling), then hold_seconds there. The last leg cuts back to the eye (a 0.05 s move under its flash: the camera only ever zooms out). Together they set the length
  // (here 9.6 s). A flash starts with each move, so a move and its hold together are at least a third of a second (at most 3 flashes a second); the check is made on load.
  // flash_peak: the flash's opacity at its peak (at most 0.6: soft); it rises over flash_rise_seconds and is gone at flash_seconds (at most 0.25). With reduce motion there is no flash at all (see reduced).
  // Music (assets/grove-after-dark, sounds.json job.done.music): up over music_in_seconds, full until music_fade_start_seconds, out over music_fade_seconds (so it ends 2 s after the camera is back). A skip (jump, fire, interact or
  // escape pressed) or damage taken ends the camera at once, with a flash back, and fades the music out over skip_fade_seconds; the controls stay off skip_lock_seconds more, so the key that skipped does nothing else.
  // reduced: reduce motion on, or a seat the camera cannot film (aircraft, turrets): only the banner and the music, over seconds, the music fading from music_fade_start_seconds over music_fade_seconds. No camera, no flash, controls stay the player's.
  "job_done_cinematic": {
    "banner_seconds": 4,
    "flash_peak": 0.5, "flash_rise_seconds": 0.04, "flash_seconds": 0.16,
    "music_in_seconds": 0.3, "music_fade_start_seconds": 9, "music_fade_seconds": 3,
    "skip_fade_seconds": 1.5, "skip_lock_seconds": 0.3,
    "party_radius_m": 30, "clearance_m": 2,
    "stages": [
      { "id": "behind", "anchor": "player", "back_m": 6,  "up_m": 3,  "look_up_m": 1.2, "drift_push_m": 0.8, "drift_turn_deg": 5, "clamp": "pull_in" },
      { "id": "above",  "anchor": "party",  "back_m": 6,  "up_m": 25, "look_up_m": 0,   "drift_push_m": 2,   "drift_turn_deg": 6, "clamp": "raise" },
      { "id": "high",   "anchor": "party",  "back_m": 12, "up_m": 80, "look_up_m": 0,   "drift_push_m": 5,   "drift_turn_deg": 8, "clamp": "raise" }
    ],
    "legs": [
      { "to": "behind", "move_seconds": 0.35, "hold_seconds": 1.5 },
      { "to": "above",  "move_seconds": 0.35, "hold_seconds": 2.5 },
      { "to": "high",   "move_seconds": 0.35, "hold_seconds": 4.5 },
      { "to": "eye",    "move_seconds": 0.05, "hold_seconds": 0 }
    ],
    "reduced": { "seconds": 4, "music_fade_start_seconds": 2.5, "music_fade_seconds": 1.5 }
  },

  // receivers (ReceiversData, ShooterCore/Cartel/Receiver.cs; docs/cartel.md "Receivers"; GLOSSARY "Receiver"): the drop of a Heist (Harvest and Trap house; a Delivery keeps its cartel_drop points). A Heist's drop is one of three
  // kinds, drawn at random among the kinds the map has (weights below: a kind with weight 0 is never drawn; a kind with no free place now, or none far enough, falls through to the next): a stash house (a hollow house with
  // road access that no player is in and no Job holds, at least the heist's drop_min_m from its objective: a Cartel pallet and a buyer at it), a helicopter (the utility helicopter on a landing spot, zone kind cartel_heli, rotors
  // turning, a pilot in it) or a boat (the Battle Royale SM_Veh_Boat_01 at a mooring, zone kind cartel_boat, with a boatman). A Receiver is not a vehicle of vehicles.json: nothing can enter it, hurt it or push it, its Cartel man
  // cannot be hurt either; the party's Duffels go into its cargo volume (carried and thrown, as into a van) and are never taken out again. Everything below is in the Receiver's own frame: forward -Z, x right, y up, origin on the
  // ground under it (the pallet's base centre, the helicopter's rotor mast, the boat's waterline), metres.
  "receivers": {
    // weights: how likely each kind is among the kinds the map has.
    "weights": { "stash_house": 1, "helicopter": 1, "boat": 1 },
    // reach_m, reach_up_m: a party player is "at the Cartel man" (the interact key is the leader's send-off, the prompt shows) within reach_m on the ground of him and reach_up_m up or down.
    "reach_m": 3.5,
    "reach_up_m": 3,
    // leave: how a helicopter or boat leaves once sent off, scripted with no physics (the server moves its entity, every client interpolates it). A helicopter climbs climb_m at climb_mps over its landing spot (turning to
    // face the way it flies, turn_deg_per_s), then flies off over the nearest map edge at fly_mps, nose down pitch_deg, and is removed exit_margin_m past the edge. A boat sails the placed route of its mooring at sail_mps and
    // is removed at the route's last point. The first ramp_seconds ease in (the speed rises from nothing).
    "leave": { "climb_m": 60, "climb_mps": 9, "fly_mps": 35, "exit_margin_m": 150, "pitch_deg": 10, "turn_deg_per_s": 45, "sail_mps": 12, "ramp_seconds": 4 },
    // Per kind. model + atlas: the model under assets-private/synty/glb (no .glb) wearing the atlas under synty/ (private pack: a box of size_m, in colour, without it); no atlas: a glb under assets/ (the
    // helicopter's generated glb). model_yaw_deg: the turn of the model in the frame (the Synty pack faces +Z, the frame's forward is -Z: 180). area_m: the van is "at the drop" within this many ground metres of the
    // Receiver (the unloading begins and the Assaults come to the drop). figure: where the Cartel man stands (feet, in the frame) and how he looks (a Gang Warfare character as the Contact is, contact.json view; yaw_deg 90
    // faces -X). cargo_volume: the box the bags go into and 15 slots they lie on (vehicles.json cargo_volume's schema: [x, y, z, yaw_deg] of a bag's base centre; no doors, no access point: nothing is taken out); a run uses
    // the first as many slots as the heist's maximum. A bag is 0.56 x 0.24 x 0.28 m (duffels.json view box [0.7, 0.3, 0.35] times scale 0.8), lying with its long side along x; the first layer fills first, the next lies on it.
    "stash_house": {
      // The Cartel pallet's own model and size (pallet.size_m, read from SM_Prop_Pallet_01.glb): deck at 0.235, 1.441 wide, 1.418 deep. Slots: 2 bags across (x +-0.3) and 4 rows (z every 0.33), then the second layer on them
      // (y 0.475): 8 + 7. The buyer stands 1.25 m to the pallet's +x side, facing it. The server turns the pallet so that side is away from the house's door (StashPlacement).
      "model": "gang-warfare/SM_Prop_Pallet_01",
      "atlas": "gang-warfare/textures/PolygonGangWarfare_01_A.png",
      "size_m": [1.441, 0.235, 1.418],
      "colour": "#8a6a45",
      "area_m": 25,
      "figure": { "pos": [1.25, 0, 0], "yaw_deg": 90, "look": { "model": "gang_boss_01", "atlas": "gang-warfare/textures/PolygonGangWarfare_02_B.png", "idle": "idle_standing_masc_g" } },
      "cargo_volume": {
        "centre": [0, 0.735, 0], "size": [1.44, 1, 1.42], "capacity": 15,
        "slots": [
          [-0.3, 0.235, -0.495, 0], [0.3, 0.235, -0.495, 0], [-0.3, 0.235, -0.165, 0], [0.3, 0.235, -0.165, 0],
          [-0.3, 0.235, 0.165, 0], [0.3, 0.235, 0.165, 0], [-0.3, 0.235, 0.495, 0], [0.3, 0.235, 0.495, 0],
          [-0.3, 0.475, -0.495, 0], [0.3, 0.475, -0.495, 0], [-0.3, 0.475, -0.165, 0], [0.3, 0.475, -0.165, 0],
          [-0.3, 0.475, 0.165, 0], [0.3, 0.475, 0.165, 0], [-0.3, 0.475, 0.495, 0]
        ]
      }
    },
    "helicopter": {
      // drycastle-generated-models/utility_helicopter.glb (scripts/models/make_utility_helicopter_model.py): the game's vehicle frame already (forward -Z, origin on the ground under the rotor mast). Measured from the model's
      // script and glb: cabin floor top 0.732 (FLOOR 0.72 plus the anti-slip plate), x +-1.2 between the walls, z -1.2 (the cockpit's B post) to 1.3 (the rear wall), roof 2.12; the troop bench lies along the rear wall
      // (x -1.08..0.3, z 0.86..1.3) and the door gunner's seat at x 0.22..0.56, z -0.07..0.37, so the bags pile on the free floor of the cabin's left half (x -1.1..0.04, z -1.19..0.49): 2 across, 6 rows, then the second layer
      // on them: 12 + 3. cargo_volume is the whole open cabin (x +-1.15, z -1.25..1.2, 1 m above the floor): a bag thrown in through either open side loads. The pilot sits in the right seat (seat_pilot, 0.55, 0.72, -1.9):
      // there is no sitting clip in the pack, so the crouch idle is lowered into the seat (a human look is due). area_m 45: the van stops on the field's edge, not under the rotor (13.4 m across).
      "model": "drycastle-generated-models/utility_helicopter.glb",
      "size_m": [2.4, 3.7, 12.6],
      "colour": "#5c6638",
      "area_m": 45,
      "figure": { "pos": [0.55, 0.55, -1.9], "yaw_deg": 0, "look": { "model": "gang_boss_01", "atlas": "gang-warfare/textures/PolygonGangWarfare_02_B.png", "idle": "crouch_idle_masc" } },
      "cargo_volume": {
        "centre": [0, 1.232, -0.025], "size": [2.3, 1, 2.45], "capacity": 15,
        "slots": [
          [-0.82, 0.732, -1.05, 0], [-0.24, 0.732, -1.05, 0], [-0.82, 0.732, -0.77, 0], [-0.24, 0.732, -0.77, 0],
          [-0.82, 0.732, -0.49, 0], [-0.24, 0.732, -0.49, 0], [-0.82, 0.732, -0.21, 0], [-0.24, 0.732, -0.21, 0],
          [-0.82, 0.732, 0.07, 0], [-0.24, 0.732, 0.07, 0], [-0.82, 0.732, 0.35, 0], [-0.24, 0.732, 0.35, 0],
          [-0.82, 0.972, -1.05, 0], [-0.24, 0.972, -1.05, 0], [-0.82, 0.972, -0.77, 0]
        ]
      }
    },
    "boat": {
      // assets-private/synty/glb/battle-royale/SM_Veh_Boat_01.glb (private pack; a box without it), origin on the waterline (hull bottom -0.565, engine -0.77, hull 3.45 wide, 8.35 long: z -3.9 stern to 4.43 bow in the pack's
      // frame, bow at +Z), turned 180 degrees into the frame (forward -Z), so every z below is the pack's negated. Measured from the glb (upward faces and obstacles on a 0.1 m grid): the cockpit floor lies at 0.2 to 0.22
      // between the hull walls at x +-0.9, the bench across the stern (frame z 2.3, 0.27..0.75 high) and the helm console (frame z 0.75..1.45, x +-0.5, 1.6 high). The bags lie on the free floor ahead of the console
      // (frame z -0.05..0.7), 3 across and 2 rows, in a pile three layers high: 6 + 6 + 3. cargo_volume is the cockpit aft of the bow deck (x +-0.86, z -0.05..2.2, 1 m above the floor). The boatman stands at the helm
      // behind the console, at the wheel, facing the bow.
      "model": "battle-royale/SM_Veh_Boat_01",
      "atlas": "battle-royale/polygon-battle-royale-01/Assets/PolygonBattleRoyale/Textures/PolygonBattleRoyale_Vehicles_01.png",
      "model_yaw_deg": 180,
      "size_m": [3.45, 3, 8.35],
      "colour": "#d8d4c8",
      "area_m": 45,
      "figure": { "pos": [0, 0.21, 1.85], "yaw_deg": 0, "look": { "model": "gang_boss_01", "atlas": "gang-warfare/textures/PolygonGangWarfare_02_B.png", "idle": "idle_standing_masc_g" } },
      "cargo_volume": {
        "centre": [0, 0.7, 1.075], "size": [1.72, 1, 2.25], "capacity": 15,
        "slots": [
          [-0.58, 0.21, 0.14, 0], [0, 0.21, 0.14, 0], [0.58, 0.21, 0.14, 0], [-0.58, 0.21, 0.42, 0],
          [0, 0.21, 0.42, 0], [0.58, 0.21, 0.42, 0], [-0.58, 0.45, 0.14, 0], [0, 0.45, 0.14, 0],
          [0.58, 0.45, 0.14, 0], [-0.58, 0.45, 0.42, 0], [0, 0.45, 0.42, 0], [0.58, 0.45, 0.42, 0],
          [-0.58, 0.69, 0.14, 0], [0, 0.69, 0.14, 0], [0.58, 0.69, 0.14, 0]
        ]
      }
    }
  },
  // One section per kind of Job, read only by that kind.
  "jobs": {
    // test: the trivial kind for the tests and "/cartel job test [tier]" (TestJobKind). seconds: the job's timer per tier (one number per tier, tier 1 first): it fails when
    // they run out. succeed_seconds: it succeeds once it has run this long (the leader alive, nothing else to do). Set it above a tier's seconds to test the timer.
    "test": {
      "name": "Test job",
      "seconds": [120, 110, 100, 90, 80],
      "succeed_seconds": 20
    },
    // delivery (DeliveryJobKind, #494): the job's duffel lies on a free spot of the pallet by the Contact (never in anyone's hands; no pallet on the map, or none of its spots free: the job does not
    // start); a party player picks it up (the interact key), carries it to within radius_m of the job's drop point (a cartel_drop zone point) and holds the interact key hold_seconds: done. The
    // duffel's loss, whatever destroys it, fails the job ("The objective was lost"). seconds: the timer per tier (tier 1 first). duffel: what it holds (duffels.json kind: weed light, cash medium, product heavy; the
    // carrier cannot sprint or take a vehicle seat). min_contact_m: the drop point is at least this far (ground metres) from the Contact; apart_m: and this far from every point another
    // running job holds (drop points and hit spots). No drop point left: the job does not start.
    "delivery": {
      "name": "Delivery",
