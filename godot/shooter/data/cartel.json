{
  "version": 1,
  // The drug Cartel (docs/cartel.md, ADR 0045; GLOSSARY "Cartel", "Cartel rank", "Respect", "Job"). Read by ShooterCore/Cartel/CartelFile.cs; nothing here was played: first guesses.
  // ranks: the personal ladder, lowest first. respect: the total Respect a member needs to hold the rank (the first is 0, each next more). Respect only grows; a member who
  // quits keeps it frozen until they rejoin. The name is what players see (the rank-up toast and chat line); the id is the key tiers name.
  "ranks": [
    { "id": "runner",  "name": "Runner",  "respect": 0 },
    { "id": "dealer",  "name": "Dealer",  "respect": 1000 },
    { "id": "sicario", "name": "Sicario", "respect": 3000 },
    { "id": "capo",    "name": "Capo",    "respect": 7000 },
    { "id": "patron",  "name": "Patrón",  "respect": 15000 }
  ],
  // tiers: the Contact lists jobs by tier, 1 first, numbered without a gap. rank: the lowest rank of the leader that opens it (never lower than the tier before's);
  // respect: what a finished job of the tier pays EVERY earning member of the party at the moment of success (a member of the Cartel with a stored Profile, not in sandbox mode).
  // A failed job pays nothing. Reward depends on the tier only (a heist adds its own bonus later).
  "tiers": [
    { "tier": 1, "rank": "runner",  "respect": 100 },
    { "tier": 2, "rank": "dealer",  "respect": 200 },
    { "tier": 3, "rank": "sicario", "respect": 350 },
    { "tier": 4, "rank": "capo",    "respect": 550 },
    { "tier": 5, "rank": "patron",  "respect": 800 }
  ],
  // contact_reach_m: how near the Contact (ground metres) a player must stand to join, quit or start a job (the map's placed Contact; a map without one has no Cartel).
  "contact_reach_m": 3,
  // One section per kind of Job, read only by that kind.
  "jobs": {
    // test: the trivial kind for the tests and "/cartel job test [tier]" (TestJobKind). seconds: the job's timer per tier (one number per tier, tier 1 first): it fails when
    // they run out. succeed_seconds: it succeeds once it has run this long (the leader alive, nothing else to do). Set it above a tier's seconds to test the timer.
    "test": {
      "name": "Test job",
      "seconds": [120, 110, 100, 90, 80],
      "succeed_seconds": 20
    },
    // delivery (DeliveryJobKind, #494): the leader gets one duffel at the Contact; a party player carrying it stands within radius_m of the job's drop point (a cartel_drop zone point)
    // and holds the interact key hold_seconds: done. seconds: the timer per tier (tier 1 first). duffel: what it holds (duffels.json kind: weed light, cash medium, product heavy; the
    // carrier cannot sprint or take a vehicle seat). min_contact_m: the drop point is at least this far (ground metres) from the Contact; apart_m: and this far from every point another
    // running job holds (drop points and hit spots). No drop point left: the job does not start.
    "delivery": {
      "name": "Delivery",
      "seconds": [240, 210, 185, 165, 150],
      "duffel": "product",
      "min_contact_m": 150,
      "apart_m": 40,
      "radius_m": 4,
      "hold_seconds": 2
    },
    // hit (HitJobKind, #497): a Rival dealer (a Rival crew's Gang boss: his own look) stands at a cartel_hit zone point with guards; his death, by anyone's hand, is success. Killing the crew
    // pays nothing. gunmen / enforcers: guards per tier for a party of one; gunmen_per_mate / enforcers_per_mate: added for each party member past the first; max_guards caps the sum
    // (Gunmen kept first). ring_m: the guards stand on a ring this far round him (snapped to the navigation mesh). reveal_m: the marker shows the spot until a party player comes this
    // near him, then follows him. min_contact_m and apart_m as delivery's.
    "hit": {
      "name": "Hit",
      "seconds": [300, 270, 240, 220, 200],
      "min_contact_m": 150,
      "apart_m": 60,
      "gunmen": [1, 2, 2, 3, 4],
      "enforcers": [2, 2, 3, 3, 4],
      "gunmen_per_mate": 1,
      "enforcers_per_mate": 0,
      "max_guards": 10,
      "ring_m": 4,
      "reveal_m": 35
    }
  }
}
