<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pure (no Godot types) clutter parsing of the map loader, compiled in so it can be tested -->
    <Compile Include="../MapLoader/ClutterData.cs" Link="MapLoader/ClutterData.cs" />
    <Compile Include="../MapLoader/MeadowData.cs" Link="MapLoader/MeadowData.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ShooterCore/ShooterCore.csproj" />
    <ProjectReference Include="../LauncherCore/LauncherCore.csproj" />
    <ProjectReference Include="../ShooterServer.Persistence/ShooterServer.Persistence.csproj" />
    <!-- the real data files are tested in place -->
    <Content Include="../shooter/data/*.json" Link="data/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
