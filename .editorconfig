root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = false
dotnet_diagnostic.IDE0005.severity = warning

[*.{py,gd}]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
