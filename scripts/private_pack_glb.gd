# Converts the prefabs of a private (paid) Godot-format pack into loose runtime GLBs and indexes them, so the game needs
# no res:// copy of the pack (nothing of it is in the .pck; the files travel in the private asset pack, scripts/make_private_pack.py).
# Run inside the pack's own Godot project (the folder with project.godot, imported once with `godot --headless --import`):
#
#   godot --headless --path assets-private/synty/military/polygon-military-01 --script ../../../../scripts/private_pack_glb.gd -- <assets-private dir> [name filter]
#   godot --headless --path assets-private/synty/farm/polygon-farm-01 --script ../../../../scripts/private_pack_glb.gd -- <assets-private dir>
#   godot --headless --path assets-private/synty/battle-royale/polygon-battle-royale-01 --script ../../../../scripts/private_pack_glb.gd -- <assets-private dir>
#
# One run converts the pack(s) of the project it runs in; manifest.json keeps the entries of the other packs (each pack has its own project).
#
# Writes, under <assets-private dir>:
#   synty/glb/<pack>/<Prefab>.glb      geometry, node names and the prefab's own collision bodies (OMI physics extensions); NO textures:
#                                      every surface wears an empty material that only carries the name of the pack material
#   synty/glb/<pack>/materials.json    name -> StandardMaterial3D settings and texture files, built once and shared by every model
#   synty/glb/<pack>/tex/              the textures those materials use (PNG; a .tga is re-saved as PNG)
#   manifest.json                      one entry per prefab in the format of assets/manifest.json: "file" (relative to the
#                                      private folder) and "prefab": true (the model brings its own collision)
# With a name filter (substring) only matching prefabs are converted and the manifest is left alone (a quick test).
# The packs are paid and never enter the repository; only this script does.
extends SceneTree

# Military and Farm ship as res://Assets/Synty/Polygon<Name>; Battle Royale as res://Assets/Polygon<Name> (no Synty folder).
var ROOT := "res://Assets/Synty"
# Prefab folders worth placing on a map. Characters, FX and weapons are not map objects.
# (Military: Environment; Farm: Environments and Plants, the crop plants of crops.json are in Plants and Props.)
const GROUPS := ["Buildings", "Props", "Environment", "Environments", "Plants", "Vehicles", "Items", "Generic"]

var _blanks := {}     # material name -> the empty stand-in put on the exported surfaces
var _materials := {}  # material name -> settings for materials.json
var _textures := {}   # res:// texture path -> file name under tex/
var _out := ""
var _failed := 0
var _mat_dir := ""    # absolute folder of the pack being written (materials.json, tex/)


func _init() -> void:
	var args := OS.get_cmdline_user_args()
	if args.is_empty():
		push_error("usage: -- <assets-private dir> [name filter]")
		quit(1)
		return
	_out = String(args[0]).trim_suffix("/")
	var filter: String = args[1] if args.size() > 1 else ""
	var root := DirAccess.open(ROOT)
	if root == null:
		ROOT = "res://Assets"
		root = DirAccess.open(ROOT)
	if root == null:
		push_error("no pack at %s (run inside the pack's Godot project)" % ROOT)
		quit(1)
		return
	var assets: Array = []
	var packs: Array = []
	var names := Array(root.get_directories())
	names.sort()
	for pack_dir in names:
		if not String(pack_dir).begins_with("Polygon"):
			continue
		var short: String = String(pack_dir).trim_prefix("Polygon").to_snake_case().replace("_", "-")
		var pack := "synty-" + short
		var dir := "synty/glb/" + short
		DirAccess.make_dir_recursive_absolute("%s/%s/tex" % [_out, dir])
		_mat_dir = "%s/%s" % [_out, dir]
		_blanks.clear()
		_materials.clear()
		_textures.clear()
		var seen := {}
		var before := assets.size()
		for group in GROUPS:
			_scan("%s/%s/Prefabs/%s" % [ROOT, pack_dir, group], pack, dir, String(group).to_lower(), filter, assets, seen)
		_write_json("%s/%s/materials.json" % [_out, dir], {"materials": _materials})
		packs.append({"id": pack, "dir": dir, "assets": assets.size() - before})
		print("%s: %d assets, %d materials, %d textures" % [pack, assets.size() - before, _materials.size(), _textures.size()])
	if filter == "":
		# the manifest is shared by every pack (each pack is converted from its own Godot project): keep the entries of the packs
		# this run did not convert, replace the ones it did
		var kept_packs: Array = []
		var kept_assets: Array = []
		var old := _read_json(_out + "/manifest.json")
		var mine := {}
		for p in packs:
			mine[p["id"]] = true
		for p in old.get("packs", []):
			if not mine.has(p.get("id", "")):
				kept_packs.append(p)
		for a in old.get("assets", []):
			if not mine.has(a.get("pack", "")):
				kept_assets.append(a)
		_write_json(_out + "/manifest.json", {
			"format_version": 1,
			"note": "Private (paid) packs: generated by scripts/private_pack_glb.gd, never committed.",
			"packs": kept_packs + packs,
			"assets": kept_assets + assets,
		})
		print("wrote %d assets (%d kept from other packs) to %s/manifest.json" % [assets.size(), kept_assets.size(), _out])
	quit(1 if _failed > 0 else 0)


func _read_json(path: String) -> Dictionary:
	if not FileAccess.file_exists(path):
		return {}
	var parsed = JSON.parse_string(FileAccess.get_file_as_string(path))
	return parsed if parsed is Dictionary else {}


func _write_json(path: String, doc: Dictionary) -> void:
	var f := FileAccess.open(path, FileAccess.WRITE)
	if f == null:
		push_error("cannot write %s" % path)
		_failed += 1
		return
	f.store_string(JSON.stringify(doc, " ") + "\n")
	f.close()


func _scan(dir_path: String, pack: String, out_dir: String, group: String, filter: String, assets: Array, seen: Dictionary) -> void:
	var dir := DirAccess.open(dir_path)
	if dir == null:
		return
	var subs := Array(dir.get_directories())
	subs.sort()
	for sub in subs:
		_scan(dir_path + "/" + sub, pack, out_dir, group, filter, assets, seen)
	var files := Array(dir.get_files())
	files.sort()
	for file in files:
		if not String(file).ends_with(".tscn"):
			continue
		var name := String(file).get_basename()
		var id := "pack:%s/%s" % [pack, name]
		if seen.has(id) or (filter != "" and not name.contains(filter)):
			continue
		var packed := load(dir_path + "/" + String(file)) as PackedScene
		if packed == null:
			push_warning("cannot load %s/%s" % [dir_path, file])
			continue
		var node := packed.instantiate()
		var box := _bounds(node, Transform3D.IDENTITY)
		if box.size == Vector3.ZERO:
			node.free()
			continue
		var rel := "%s/%s.glb" % [out_dir, name]
		var ok := _export(node, "%s/%s" % [_out, rel])
		node.free()
		if not ok:
			_failed += 1
			continue
		seen[id] = true
		assets.append({
			"id": id,
			"category": "other",
			"name": name.trim_prefix("SM_").replace("_", " "),
			"file": rel,
			"prefab": true,
			"size_m": [snappedf(box.size.x, 0.01), snappedf(box.size.y, 0.01), snappedf(box.size.z, 0.01)],
			"tags": ["private", pack, group],
			"pack": pack,
		})


# Writes one prefab as a GLB: its meshes wear name-only materials, everything else (node names, transforms, bodies, shapes) is kept.
func _export(scene: Node, path: String) -> bool:
	var root := Node3D.new()
	root.name = "Prefab"  # not the prefab's name: the exporter renames a child that shares its parent's name
	root.add_child(scene)  # a prefab root is itself a mesh: keep it as a child so its name and bodies survive
	_own(root, root)
	_strip(scene)
	var doc := GLTFDocument.new()
	var state := GLTFState.new()
	var err := doc.append_from_scene(root, state)
	if err == OK:
		err = doc.write_to_filesystem(state, path)
	root.remove_child(scene)
	root.free()
	if err != OK:
		push_error("export failed (%s): %s" % [error_string(err), path])
	return err == OK


func _own(n: Node, root: Node) -> void:
	for c in n.get_children():
		c.owner = root
		_own(c, root)


func _strip(n: Node) -> void:
	if n is MeshInstance3D and (n as MeshInstance3D).mesh != null:
		var mi := n as MeshInstance3D
		if mi.get_node_or_null(mi.skeleton) as Skeleton3D == null:
			mi.skin = null  # a static mesh that kept the skin of its FBX: without a skeleton the exporter trips on it
		mi.material_override = null
		for i in mi.mesh.get_surface_count():
			mi.set_surface_override_material(i, _blank(mi.get_active_material(i)))
	for c in n.get_children():
		_strip(c)


# The stand-in for a pack material: empty, with the material's name. The settings go to materials.json once.
func _blank(mat: Material) -> StandardMaterial3D:
	var name := "default"
	if mat != null:
		name = mat.resource_name if mat.resource_name != "" else mat.resource_path.get_file().get_basename()
	if name == "":
		name = "default"
	if not _blanks.has(name):
		var b := StandardMaterial3D.new()
		b.resource_name = name
		_blanks[name] = b
		_materials[name] = _describe(mat)
	return _blanks[name]


func _describe(mat: Material) -> Dictionary:
	var m := mat as BaseMaterial3D
	if m == null:
		if mat != null:
			push_warning("material %s is a %s: drawn plain" % [mat.resource_path, mat.get_class()])
		return {}
	var d := {
		"albedo_color": "#" + m.albedo_color.to_html(true),
		"roughness": m.roughness,
		"metallic": m.metallic,
		"metallic_specular": m.metallic_specular,
		"transparency": m.transparency,  # BaseMaterial3D.Transparency
		"alpha_scissor_threshold": m.alpha_scissor_threshold,
		"cull_mode": m.cull_mode,        # BaseMaterial3D.CullMode
		"shading_mode": m.shading_mode,  # BaseMaterial3D.ShadingMode
		"uv1_scale": [m.uv1_scale.x, m.uv1_scale.y],
		"uv1_offset": [m.uv1_offset.x, m.uv1_offset.y],
	}
	var albedo := _texture(m.albedo_texture)
	if albedo != "":
		d["albedo_texture"] = albedo
	if m.normal_enabled:
		var normal := _texture(m.normal_texture)
		if normal != "":
			d["normal_texture"] = normal
			d["normal_scale"] = m.normal_scale
	if m.emission_enabled:
		d["emission_color"] = "#" + m.emission.to_html(false)
		d["emission_energy"] = m.emission_energy_multiplier
		if m.emission_operator == BaseMaterial3D.EMISSION_OP_MULTIPLY:
			d["emission_operator"] = 1  # the colour times the texture (the default, 0, adds them: a white colour would glow all over)
		var emission := _texture(m.emission_texture)
		if emission != "":
			d["emission_texture"] = emission
	return d


# Copies a texture's source file to tex/ (once) and returns its path relative to the materials.json folder.
func _texture(tex: Texture2D) -> String:
	if tex == null or tex.resource_path == "":
		return ""
	var src := tex.resource_path
	if not _textures.has(src):
		var name := src.get_file()
		var dst := "%s/tex/%s" % [_mat_dir, name]
		var err := OK
		if name.get_extension().to_lower() == "png":
			err = DirAccess.copy_absolute(ProjectSettings.globalize_path(src), dst)
		else:
			# an uncompressed .tga (16 MB): the same pixels as a PNG
			name = name.get_basename() + ".png"
			dst = "%s/tex/%s" % [_mat_dir, name]
			var img := Image.load_from_file(ProjectSettings.globalize_path(src))
			err = img.save_png(dst) if img != null else ERR_FILE_CANT_READ
		if err != OK:
			push_error("cannot copy texture %s (%s)" % [src, error_string(err)])
			_failed += 1
			return ""
		_textures[src] = "tex/" + name
	return _textures[src]


# The box around every mesh of a scene that is not in the tree (so the transforms are multiplied by hand).
func _bounds(node: Node, parent: Transform3D) -> AABB:
	var xf := parent
	if node is Node3D:
		xf = parent * (node as Node3D).transform
	var box := AABB()
	var any := false
	if node is MeshInstance3D and (node as MeshInstance3D).mesh != null:
		box = xf * (node as MeshInstance3D).mesh.get_aabb()
		any = true
	for child in node.get_children():
		var b := _bounds(child, xf)
		if b.size != Vector3.ZERO:
			box = box.merge(b) if any else b
			any = true
	return box
