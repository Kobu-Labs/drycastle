# Indexes the private asset packs linked into a Godot project (res://Assets/Synty/<Pack>, see docs/private-assets.md)
# and writes assets-private/manifest.json: one entry per prefab scene with its measured size, in the format of
# assets/manifest.json plus "scene" (the res:// path the game instances directly, in place of "file").
#
#   godot --headless --path godot/viewer --script ../../scripts/private_pack_index.gd -- <out manifest.json>
#
# The packs themselves are paid and never enter the repository; only this script does.
extends SceneTree

const ROOT := "res://Assets/Synty"
# Prefab folders worth placing on a map. Characters, FX and weapons are not map objects.
const GROUPS := ["Buildings", "Props", "Environment", "Vehicles", "Items", "Generic"]


func _init() -> void:
	var args := OS.get_cmdline_user_args()
	if args.is_empty():
		push_error("usage: -- <out manifest.json>")
		quit(1)
		return
	var assets: Array = []
	var packs: Array = []
	var seen := {}
	var root := DirAccess.open(ROOT)
	if root == null:
		push_error("no packs linked at %s" % ROOT)
		quit(1)
		return
	var names := Array(root.get_directories())
	names.sort()
	for pack_dir in names:
		var pack: String = "synty-" + String(pack_dir).trim_prefix("Polygon").to_snake_case().replace("_", "-")
		var before := assets.size()
		for group in GROUPS:
			_scan("%s/%s/Prefabs/%s" % [ROOT, pack_dir, group], pack, String(group).to_lower(), assets, seen)
		packs.append({"id": pack, "dir": pack_dir, "assets": assets.size() - before})
		print("%s: %d assets" % [pack, assets.size() - before])
	var doc := {
		"format_version": 1,
		"note": "Private (paid) packs: generated by scripts/private_pack_index.gd, never committed.",
		"packs": packs,
		"assets": assets,
	}
	var f := FileAccess.open(args[0], FileAccess.WRITE)
	if f == null:
		push_error("cannot write %s" % args[0])
		quit(1)
		return
	f.store_string(JSON.stringify(doc, " ") + "\n")
	f.close()
	print("wrote %d assets to %s" % [assets.size(), args[0]])
	quit(0)


func _scan(dir_path: String, pack: String, group: String, assets: Array, seen: Dictionary) -> void:
	var dir := DirAccess.open(dir_path)
	if dir == null:
		return
	var subs := Array(dir.get_directories())
	subs.sort()
	for sub in subs:
		_scan(dir_path + "/" + sub, pack, group, assets, seen)
	var files := Array(dir.get_files())
	files.sort()
	for file in files:
		if not String(file).ends_with(".tscn"):
			continue
		var name := String(file).get_basename()
		var id := "pack:%s/%s" % [pack, name]
		if seen.has(id):
			continue
		var path: String = dir_path + "/" + String(file)
		var packed := load(path) as PackedScene
		if packed == null:
			push_warning("cannot load %s" % path)
			continue
		var node := packed.instantiate()
		var box := _bounds(node, Transform3D.IDENTITY)
		node.free()
		if box.size == Vector3.ZERO:
			continue
		seen[id] = true
		assets.append({
			"id": id,
			"category": "other",
			"name": name.trim_prefix("SM_").replace("_", " "),
			"scene": path,
			"size_m": [snappedf(box.size.x, 0.01), snappedf(box.size.y, 0.01), snappedf(box.size.z, 0.01)],
			"tags": ["private", pack, group],
			"pack": pack,
		})


# The box around every mesh of a scene that is not in the tree (so the transforms are multiplied by hand).
func _bounds(node: Node, parent: Transform3D) -> AABB:
	var xf := parent
	if node is Node3D:
		xf = parent * (node as Node3D).transform
	var box := AABB()
	var any := false
	if node is MeshInstance3D and (node as MeshInstance3D).mesh != null:
		box = xf * (node as MeshInstance3D).mesh.get_aabb()
		any = true
	for child in node.get_children():
		var b := _bounds(child, xf)
		if b.size != Vector3.ZERO:
			box = box.merge(b) if any else b
			any = true
	return box
