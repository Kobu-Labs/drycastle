# Step 2 of the POLYGON QuadBike batch (scripts/build_vehicle_packs.sh): the imported quad bike FBX -> one runtime GLB, the same files as
# scripts/private_pack_glb.gd writes for a Godot-format pack (pack id "synty-quadbike", manifest.json entry, materials.json + tex/).
#   godot --headless --path assets-private/synty/quadbike --script <repo>/scripts/quadbike_export.gd -- <assets-private dir>
# Writes under <assets-private dir>:
#   synty/glb/quadbike/SM_Veh_QuadBike_01.glb   node tree of the FBX (body with wheels, handlebar, cargo racks, shovel as child nodes, node names and
#                                               pivots unchanged, AnimationPlayer dropped); every surface wears an empty material named
#                                               "PolygonQuadBike_01" (the pack's default atlas)
#   synty/glb/quadbike/materials.json + tex/    PolygonQuadBike_01..04 (the four atlases: same UVs, only the paint differs, so a model can wear any of
#                                               them) + PolygonQuadBike_01_Emissive.png (emission off in the pack's materials: not enabled)
#   manifest.json                               id pack:synty-quadbike/SM_Veh_QuadBike_01 ("prefab": true); the entries of the other packs are kept
extends SceneTree

const MODEL := "SM_Veh_QuadBike_01"
const PACK := "synty-quadbike"
const DIR := "synty/glb/quadbike"


func _init() -> void:
	var args := OS.get_cmdline_user_args()
	if args.is_empty():
		push_error("usage: -- <assets-private dir>")
		quit(1)
		return
	var out := String(args[0]).trim_suffix("/")
	DirAccess.make_dir_recursive_absolute("%s/%s/tex" % [out, DIR])
	var scene := (load("res://fbx/%s.fbx" % MODEL) as PackedScene).instantiate()
	for p in scene.find_children("*", "AnimationPlayer", true, false):
		p.get_parent().remove_child(p)
		p.free()
	scene.name = "QuadBike"  # the FBX root and its body mesh are both called SM_Veh_QuadBike_01: the exporter would rename the child to ..._012
	var blank := StandardMaterial3D.new()
	blank.resource_name = "PolygonQuadBike_01"
	var root := Node3D.new()
	root.name = "Prefab"  # as private_pack_glb.gd: the prefab root stays a child so its name survives
	root.add_child(scene)
	_own(root, root)
	_blank(scene, blank)
	var doc := GLTFDocument.new()
	var state := GLTFState.new()
	var err := doc.append_from_scene(root, state)
	var glb := "%s/%s/%s.glb" % [out, DIR, MODEL]
	if err == OK:
		err = doc.write_to_filesystem(state, glb)
	var box := _bounds(scene, Transform3D.IDENTITY)
	root.remove_child(scene)
	root.free()
	scene.free()
	if err != OK:
		push_error("export failed (%s)" % error_string(err))
		quit(1)
		return
	var mats := {}
	for i in range(1, 5):
		var tex := "PolygonQuadBike_%02d.png" % i
		DirAccess.copy_absolute(ProjectSettings.globalize_path("res://textures/" + tex), "%s/%s/tex/%s" % [out, DIR, tex])
		mats["PolygonQuadBike_%02d" % i] = {"albedo_color": "#ffffffff", "albedo_texture": "tex/" + tex, "roughness": 0.8, "metallic": 0.0, "metallic_specular": 0.5,
			"transparency": 0, "cull_mode": 0, "shading_mode": 1, "uv1_scale": [1, 1], "uv1_offset": [0, 0]}
	DirAccess.copy_absolute(ProjectSettings.globalize_path("res://textures/PolygonQuadBike_01_Emissive.png"), "%s/%s/tex/PolygonQuadBike_01_Emissive.png" % [out, DIR])
	_write_json("%s/%s/materials.json" % [out, DIR], {"materials": mats})
	# manifest: replace this pack's entries, keep the others
	var old := _read_json(out + "/manifest.json")
	var packs: Array = []
	for p in old.get("packs", []):
		if p.get("id", "") != PACK:
			packs.append(p)
	var assets: Array = []
	for a in old.get("assets", []):
		if a.get("pack", "") != PACK:
			assets.append(a)
	assets.append({"id": "pack:%s/%s" % [PACK, MODEL], "category": "other", "name": "Veh QuadBike 01", "file": "%s/%s.glb" % [DIR, MODEL], "prefab": true,
		"size_m": [snappedf(box.size.x, 0.01), snappedf(box.size.y, 0.01), snappedf(box.size.z, 0.01)], "tags": ["private", PACK, "vehicles"], "pack": PACK})
	packs.append({"id": PACK, "dir": DIR, "assets": 1})
	_write_json(out + "/manifest.json", {"format_version": 1, "note": old.get("note", "Private (paid) packs: generated by scripts/private_pack_glb.gd, never committed."), "packs": packs, "assets": assets})
	print("%s: %.3f x %.3f x %.3f m, wrote %s" % [MODEL, box.size.x, box.size.y, box.size.z, glb])
	quit(0)


func _own(n: Node, root: Node) -> void:
	for c in n.get_children():
		c.owner = root
		_own(c, root)


func _blank(n: Node, mat: StandardMaterial3D) -> void:
	if n is MeshInstance3D and (n as MeshInstance3D).mesh != null:
		var mi := n as MeshInstance3D
		mi.skin = null
		mi.material_override = null
		for i in mi.mesh.get_surface_count():
			mi.set_surface_override_material(i, mat)
	for c in n.get_children():
		_blank(c, mat)


func _bounds(node: Node, parent: Transform3D) -> AABB:
	var xf := parent
	if node is Node3D:
		xf = parent * (node as Node3D).transform
	var box := AABB()
	var any := false
	if node is MeshInstance3D and (node as MeshInstance3D).mesh != null:
		box = xf * (node as MeshInstance3D).mesh.get_aabb()
		any = true
	for child in node.get_children():
		var b := _bounds(child, xf)
		if b.size != Vector3.ZERO:
			box = box.merge(b) if any else b
			any = true
	return box


func _read_json(path: String) -> Dictionary:
	if not FileAccess.file_exists(path):
		return {}
	var parsed = JSON.parse_string(FileAccess.get_file_as_string(path))
	return parsed if parsed is Dictionary else {}


func _write_json(path: String, doc: Dictionary) -> void:
	var f := FileAccess.open(path, FileAccess.WRITE)
	f.store_string(JSON.stringify(doc, " ") + "\n")
	f.close()
